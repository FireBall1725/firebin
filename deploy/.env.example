# Copy to .env and fill in. docker compose reads .env automatically.

# Public hostname. Must resolve to this server; Caddy gets a TLS cert for it.
# For a LAN-only test with no domain, see the README (camera and WebUSB printing
# need HTTPS or localhost).
DOMAIN=firebin.example.com

# Session signing key. Generate one and keep it stable, or every restart logs
# everyone out:   openssl rand -base64 48
JWT_SECRET=

# Postgres password. Any strong value; the database port is not published.
POSTGRES_PASSWORD=

# Image tag to run. Pin a released version for alpha rather than tracking latest.
FIREBIN_VERSION=latest

# Optional Digi-Key enrichment. You can also set these in the UI at
# Settings -> Enrichment (stored in the database), so leave blank if you prefer.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
